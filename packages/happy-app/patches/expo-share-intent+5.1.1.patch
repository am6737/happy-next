+// MARK: - Happy: where the shared content goes
+
+/// What the app leaves in the App Group for the sheet (modules/share-extension): its online
+/// sessions, its strings in the app's language and its colours.
+struct ShareSnapshot: Decodable {
+  struct Session: Decodable {
+    let id: String
+    let name: String
+    let subtitle: String
+    let avatar: Avatar?
+  }
+  struct Themed: Decodable {
+    let light: String
+    let dark: String
+  }
+  /// The session's avatar in the app's avatar style, without its badges: an image (a file the app
+  /// copied into the App Group's share-avatars) on its background, tinted, at its scale; or the
+  /// pixel style's 8×8 cells, row by row.
+  struct Avatar: Decodable {
+    let image: String?
+    let imageScale: Double?
+    let tint: Themed?
+    let background: Themed?
+    let pixels: [String]?
+  }
+  struct Palette: Decodable {
+    let background: String
+    let field: String
+    let text: String
+    let textSecondary: String
+    let divider: String
+    let pressed: String
+    let tint: String
+    let accent: String
+    let accentTint: String
+    let online: String
+  }
+  struct Strings: Decodable {
+    let title: String
+    let cancel: String
+    let searchPlaceholder: String
+    let newSession: String
+    let activeSessions: String
+    let noActiveSessions: String
+    let noResults: String
+    let text: String
+    // Indexed by count - 1
+    let images: [String]
+    let videos: [String]
+    let files: [String]
+  }
+  // light, dark or adaptive (the system's)
+  let appearance: String
+  let light: Palette
+  let dark: Palette
+  let strings: Strings
+  let sessions: [Session]
+}
+
+final class SharePickerModel: ObservableObject {
+  @Published var query = ""
+  @Published var subtitle = ""
+  @Published var sending = false
+}
+
+extension ShareViewController {
+  func showPicker(snapshot: ShareSnapshot, attachments: [NSItemProvider]) {
+    let model = SharePickerModel()
+    let picker = SharePickerView(
+      snapshot: snapshot, model: model,
+      avatars: FileManager.default
+        .containerURL(forSecurityApplicationGroupIdentifier: hostAppGroupIdentifier)?
+        .appendingPathComponent("share-avatars"),
+      onCancel: { [weak self] in
+        self?.extensionContext?.cancelRequest(
+          withError: NSError(domain: NSCocoaErrorDomain, code: NSUserCancelledError))
+      },
+      onPick: { [weak self] target in
+        guard let self, !model.sending else { return }
+        model.sending = true
+        let defaults = UserDefaults(suiteName: self.hostAppGroupIdentifier)
+        defaults?.set(target, forKey: self.targetKey)
+        defaults?.synchronize()
+        self.handleAttachments()
+      })
+    let host = UIHostingController(rootView: picker)
+    if snapshot.appearance == "light" {
+      overrideUserInterfaceStyle = .light
+    } else if snapshot.appearance == "dark" {
+      overrideUserInterfaceStyle = .dark
+    }
+    addChild(host)
+    host.view.translatesAutoresizingMaskIntoConstraints = false
+    view.addSubview(host.view)
+    NSLayoutConstraint.activate([
+      host.view.topAnchor.constraint(equalTo: view.topAnchor),
+      host.view.bottomAnchor.constraint(equalTo: view.bottomAnchor),
+      host.view.leadingAnchor.constraint(equalTo: view.leadingAnchor),
+      host.view.trailingAnchor.constraint(equalTo: view.trailingAnchor),
+    ])
+    host.didMove(toParent: self)
+    describe(attachments: attachments, strings: snapshot.strings, model: model)
+  }
+
+  /// The subtitle: how many images, videos and files, the name of a lone file, or the start of
+  /// the text. Read off the attachments in the order handleAttachments takes them.
+  private func describe(attachments: [NSItemProvider], strings: ShareSnapshot.Strings, model: SharePickerModel) {
+    var images = 0
+    var videos = 0
+    var files: [NSItemProvider] = []
+    var texts: [NSItemProvider] = []
+    for attachment in attachments {
+      if attachment.hasItemConformingToTypeIdentifier(imageContentType) {
+        images += 1
+      } else if attachment.hasItemConformingToTypeIdentifier(videoContentType) {
+        videos += 1
+      } else if [vcardContentType, fileURLType, pkpassContentType, pdfContentType].contains(where: {
+        attachment.hasItemConformingToTypeIdentifier($0)
+      }) {
+        files.append(attachment)
+      } else {
+        texts.append(attachment)
+      }
+    }
+    func counted(_ forms: [String], _ count: Int) -> String? {
+      count > 0 && !forms.isEmpty ? forms[min(count, forms.count) - 1] : nil
+    }
+    var parts: [String] = []
+    if !texts.isEmpty { parts.append(strings.text) }
+    if let part = counted(strings.images, images) { parts.append(part) }
+    if let part = counted(strings.videos, videos) { parts.append(part) }
+    if files.count == 1, images + videos == 0, let name = files[0].suggestedName, !name.isEmpty {
+      parts.append(name)
+    } else if let part = counted(strings.files, files.count) {
+      parts.append(part)
+    }
+    model.subtitle = parts.joined(separator: " · ")
+
+    // Text alone: show how it starts
+    guard images + videos + files.count == 0, let provider = texts.first else { return }
+    let type = provider.hasItemConformingToTypeIdentifier(urlContentType) ? urlContentType : textContentType
+    guard provider.hasItemConformingToTypeIdentifier(type) else { return }
+    provider.loadItem(forTypeIdentifier: type, options: nil) { item, _ in
+      var text: String?
+      if let url = item as? URL {
+        text = url.absoluteString
+      } else if let string = item as? String {
+        text = string
+      } else if let data = item as? Data {
+        text = String(data: data, encoding: .utf8)
+      }
+      let line = text?.split(whereSeparator: \.isNewline).first.map {
+        $0.trimmingCharacters(in: .whitespaces)
+      }
+      guard let line, !line.isEmpty else { return }
+      DispatchQueue.main.async {
+        model.subtitle = "\(strings.text) · “\(line)”"
+      }
+    }
+  }
+}
