+/// The sheet: cancel and the title (what's shared under it) in the navigation bar, then the app's
+/// search field, a new session and the online ones; while searching only the sessions that match.
+struct SharePickerView: View {
+  let snapshot: ShareSnapshot
+  @ObservedObject var model: SharePickerModel
+  let onCancel: () -> Void
+  let onPick: (String) -> Void
+  let avatars: URL?
+  let palette: SharePalette
+
+  init(
+    snapshot: ShareSnapshot, model: SharePickerModel, avatars: URL?,
+    onCancel: @escaping () -> Void, onPick: @escaping (String) -> Void
+  ) {
+    self.snapshot = snapshot
+    self.model = model
+    self.avatars = avatars
+    self.onCancel = onCancel
+    self.onPick = onPick
+    self.palette = SharePalette(snapshot.light, snapshot.dark)
+  }
+
+  private var searching: Bool {
+    !model.query.trimmingCharacters(in: .whitespaces).isEmpty
+  }
+
+  private var sessions: [ShareSnapshot.Session] {
+    let query = model.query.trimmingCharacters(in: .whitespaces)
+    guard !query.isEmpty else { return snapshot.sessions }
+    return snapshot.sessions.filter {
+      $0.name.localizedCaseInsensitiveContains(query) || $0.subtitle.localizedCaseInsensitiveContains(query)
+    }
+  }
+
+  // The system's navigation bar, clear at the top and translucent once the list scrolls under
+  // it; the search field scrolls with the list
+  var body: some View {
+    NavigationView {
+      ScrollView {
+        LazyVStack(alignment: .leading, spacing: 0) {
+          searchField
+            .padding(.horizontal, 16)
+            .padding(.top, 8)
+            .padding(.bottom, 8)
+          if !searching {
+            newSessionRow
+            Text(snapshot.strings.activeSessions)
+              .font(.system(size: 13, weight: .semibold))
+              .foregroundColor(palette.textSecondary)
+              .padding(.horizontal, 16)
+              .padding(.top, 16)
+              .padding(.bottom, 4)
+          }
+          let list = sessions
+          if list.isEmpty {
+            Text(searching ? snapshot.strings.noResults : snapshot.strings.noActiveSessions)
+              .font(.system(size: 15))
+              .foregroundColor(palette.textSecondary)
+              .frame(maxWidth: .infinity)
+              .padding(.top, 24)
+          }
+          ForEach(Array(list.enumerated()), id: \.element.id) { index, session in
+            if index > 0 { divider }
+            sessionRow(session)
+          }
+        }
+        .padding(.bottom, 16)
+      }
+      .background(palette.background.ignoresSafeArea())
+      .navigationBarTitleDisplayMode(.inline)
+      .toolbar {
+        ToolbarItem(placement: .cancellationAction) {
+          Button(snapshot.strings.cancel, action: onCancel)
+            .foregroundColor(palette.tint)
+        }
+        ToolbarItem(placement: .principal) {
+          title
+        }
+      }
+    }
+    .navigationViewStyle(.stack)
+    .overlay(sending)
+    .disabled(model.sending)
+  }
+
+  private var title: some View {
+    VStack(spacing: 1) {
+      Text(snapshot.strings.title)
+        .font(.system(size: 17, weight: .semibold))
+        .foregroundColor(palette.text)
+      if !model.subtitle.isEmpty {
+        Text(model.subtitle)
+          .font(.system(size: 12))
+          .foregroundColor(palette.textSecondary)
+      }
+    }
+    .lineLimit(1)
+  }
+
+  // The app's SearchField: 36 tall, corners of 10, a search glyph, text at 16 and a clear button
+  private var searchField: some View {
+    HStack(spacing: 6) {
+      Image(systemName: "magnifyingglass")
+        .font(.system(size: 15, weight: .medium))
+        .foregroundColor(palette.textSecondary)
+      TextField("", text: $model.query)
+        .font(.system(size: 16))
+        .foregroundColor(palette.text)
+        .disableAutocorrection(true)
+        .textInputAutocapitalization(.never)
+        .submitLabel(.search)
+        .overlay(alignment: .leading) {
+          if model.query.isEmpty {
+            Text(snapshot.strings.searchPlaceholder)
+              .font(.system(size: 16))
+              .foregroundColor(palette.textSecondary)
+              .allowsHitTesting(false)
+          }
+        }
+      if !model.query.isEmpty {
+        Button {
+          model.query = ""
+        } label: {
+          Image(systemName: "xmark.circle.fill")
+            .font(.system(size: 16))
+            .foregroundColor(palette.textSecondary)
+        }
+        .buttonStyle(.plain)
+      }
+    }
+    .padding(.horizontal, 8)
+    .frame(height: 36)
+    .background(palette.field)
+    .cornerRadius(10)
+  }
+
+  private var divider: some View {
+    Rectangle()
+      .fill(palette.divider)
+      .frame(height: 1 / UIScreen.main.scale)
+      .padding(.leading, 16 + 40 + 12)
+  }
+
+  private var newSessionRow: some View {
+    Button {
+      onPick("new")
+    } label: {
+      HStack(spacing: 12) {
+        Image(systemName: "plus")
+          .font(.system(size: 20, weight: .medium))
+          .foregroundColor(palette.accentTint)
+          .frame(width: 40, height: 40)
+          .background(Circle().fill(palette.accent))
+        Text(snapshot.strings.newSession)
+          .font(.system(size: 16, weight: .semibold))
+          .foregroundColor(palette.text)
+        Spacer(minLength: 8)
+        Image(systemName: "chevron.right")
+          .font(.system(size: 14, weight: .semibold))
+          .foregroundColor(palette.textSecondary)
+      }
+      .padding(.horizontal, 16)
+      .padding(.vertical, 10)
+    }
+    .buttonStyle(ShareRowStyle(pressed: palette.pressed))
+  }
+
+  private func sessionRow(_ session: ShareSnapshot.Session) -> some View {
+    Button {
+      onPick("session:\(session.id)")
+    } label: {
+      HStack(spacing: 12) {
+        ShareAvatarView(avatar: session.avatar, directory: avatars, placeholder: palette.field)
+        VStack(alignment: .leading, spacing: 2) {
+          Text(session.name)
+            .font(.system(size: 16, weight: .medium))
+            .foregroundColor(palette.text)
+          Text(session.subtitle)
+            .font(.system(size: 13))
+            .foregroundColor(palette.textSecondary)
+        }
+        .lineLimit(1)
+        Spacer(minLength: 8)
+        Circle()
+          .fill(palette.online)
+          .frame(width: 8, height: 8)
+      }
+      .padding(.horizontal, 16)
+      .padding(.vertical, 10)
+    }
+    .buttonStyle(ShareRowStyle(pressed: palette.pressed))
+  }
+
+  // Copying the files over can take a moment for videos
+  @ViewBuilder private var sending: some View {
+    if model.sending {
+      ZStack {
+        palette.background.opacity(0.6).ignoresSafeArea()
+        ProgressView()
+      }
+    }
+  }
+}
