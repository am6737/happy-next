+/// A session's avatar as the app draws it (Avatar, without the badges), 40pt; a plain circle when
+/// its image can't be read.
+struct ShareAvatarView: View {
+  let avatar: ShareSnapshot.Avatar?
+  let directory: URL?
+  let placeholder: Color
+  private let size: CGFloat = 40
+
+  var body: some View {
+    content
+      .frame(width: size, height: size)
+      .clipShape(Circle())
+  }
+
+  @ViewBuilder private var content: some View {
+    if let pixels = avatar?.pixels, pixels.count == 64 {
+      VStack(spacing: 0) {
+        ForEach(0..<8, id: \.self) { row in
+          HStack(spacing: 0) {
+            ForEach(0..<8, id: \.self) { column in
+              Color(UIColor(hex: pixels[row * 8 + column]))
+            }
+          }
+        }
+      }
+    } else if let avatar, let name = avatar.image,
+      let image = directory.flatMap({ UIImage(contentsOfFile: $0.appendingPathComponent(name).path) })
+    {
+      let side = size * CGFloat(avatar.imageScale ?? 1)
+      ZStack {
+        if let background = avatar.background {
+          Color(light: background.light, dark: background.dark)
+        }
+        if let tint = avatar.tint {
+          Image(uiImage: image)
+            .renderingMode(.template)
+            .resizable()
+            .foregroundColor(Color(light: tint.light, dark: tint.dark))
+            .frame(width: side, height: side)
+            .clipShape(Circle())
+        } else {
+          Image(uiImage: image)
+            .resizable()
+            .scaledToFill()
+            .frame(width: side, height: side)
+        }
+      }
+    } else {
+      placeholder
+    }
+  }
+}
