# ============================================================================
# happy-voice — 火山引擎 AI 音视频互动方案(2025-06-01, ArkV3 内置豆包)语音网关
# 复制为 .env.local 后填写。生产经 deploy/.env 注入。
#
# 下方分两段：必填项(无默认值,不填启动即报错) 与 可调项(都有默认值,不填也能跑)。
# ============================================================================

# ─────────────────────────────── 必填 ───────────────────────────────

# API server 签发短期 voice bearer token 的共享密钥；happy-server 与 happy-voice 必须一致。
VOICE_AUTH_SECRET=dev-voice-auth-secret-change-me-32-bytes

# 火山 RTC(必须是「AI 智能体」类型的应用)
VOLC_RTC_APP_ID=
VOLC_RTC_APP_KEY=

# 火山 OpenAPI 签名(IAM 访问密钥, StartVoiceChat/StopVoiceChat)
VOLC_ACCESS_KEY_ID=
VOLC_SECRET_ACCESS_KEY=

# 消息朗读 TTS(App「朗读消息」功能, 一次性 REST 合成)
VOLC_TTS_APP_ID=
VOLC_TTS_TOKEN=

# ──────────────────── 可调(均有默认值, 一般无需修改)────────────────────

# —— 服务 ——
HOST=0.0.0.0
PORT=3040
NODE_ENV=development

# —— 火山 RTC OpenAPI ——
VOLC_RTC_REGION=cn-north-1
VOLC_RTC_API_VERSION=2025-06-01
RTC_TOKEN_TTL_SECONDS=86400

# —— ASR(seed 大模型流式; 鉴权绑定在 agent app 上, 无需单独 token)——
VOLC_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
VOLC_ASR_STREAM_MODE=2
VOLC_ASR_SILENCE_MS=600

# —— LLM(豆包, 内置 ArkV3, 火山机房内流式)——
DOUBAO_MODEL=doubao-seed-2-0-lite-260428
LLM_THINKING_TYPE=disabled
LLM_HISTORY_LENGTH=10
LLM_TEMPERATURE=0.1
LLM_TOP_P=0.3
LLM_MAX_TOKENS=512

# —— 统一音色(实时对话 + 朗读消息共用)——
VOLC_TTS_VOICE=zh_female_vv_uranus_bigtts

# —— Agent TTS(双向流式, 用于实时对话)——
# uranus 等多语种音色需 seed-tts-2.0。
VOLC_AGENT_TTS_RESOURCE_ID=seed-tts-2.0

# —— 消息朗读 TTS ——
VOLC_TTS_CLUSTER=volcano_tts

# —— 朗读前的文本清洗(去 markdown/代码/链接)。LLM 清洗需 ARK_API_KEY; 关掉则用正则。——
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
TTS_CLEAN_LLM=true
TTS_CLEAN_MODEL=doubao-seed-2-0-lite-260428
TTS_CLEAN_TIMEOUT_MS=8000

# —— 默认语言 / 欢迎语 ——
DEFAULT_LANGUAGE=zh
# 可用 | 分隔多个，每次进房随机选一条。例：你好，需要我做点什么？|在的，说吧|我在听
AGENT_WELCOME_MESSAGE=你好，需要我做点什么？

# —— Prompt 模板 ——
PROMPT_VOICE_AGENT_FILE=prompts/voice-agent.system.txt
