# Drives `eas credentials -p ios` (no non-interactive download in eas-cli 18.x) to download the
# Ad Hoc cert/profile of one build profile into credentials.json + credentials/ios/.
# Env: ARROWS = number of down-arrows that select the build profile in the first menu.
# The caller must still check that the files exist: this script can't tell every failure.
set timeout 300
log_user 1
set arrows $env(ARROWS)

spawn eas credentials -p ios
expect {
  -re "Which build profile" { }
  timeout { puts "TIMEOUT waiting for the profile menu"; exit 2 }
}
for {set i 0} {$i < $arrows} {incr i} { send -- "\033\[B"; sleep 0.2 }
sleep 0.5
send -- "\r"
expect {
  -re "Do you want to log in to your Apple account" { send -- "n\r"; exp_continue }
  -re "Some of the build targets" { puts "EAS_TARGET_ERROR"; exit 3 }
  -re "What do you want to do" { }
  timeout { puts "TIMEOUT waiting for the action menu"; exit 2 }
}
sleep 1
# 4th item: credentials.json: Upload/Download credentials between EAS servers and your local json
for {set i 0} {$i < 3} {incr i} { send -- "\033\[B"; sleep 0.3 }
send -- "\r"
expect {
  -re "Download credentials from EAS to credentials.json" { }
  timeout { puts "TIMEOUT waiting for the credentials.json menu"; exit 2 }
}
sleep 0.3
send -- "\r"
expect {
  -re "Which type of internal distribution" { send -- "\r"; exp_continue }
  -re "Some of the build targets" { puts "EAS_TARGET_ERROR"; exit 3 }
  -re "credentials.json is synced|synced|success|What do you want to do" { }
  timeout { puts "TIMEOUT waiting for the download"; exit 2 }
}
sleep 2
puts "DOWNLOAD DONE"
exit 0
